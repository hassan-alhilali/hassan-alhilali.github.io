---
import { t, type Lang } from '../i18n/content';
import HealthCheck from './visuals/HealthCheck.astro';
import SCurve from './visuals/SCurve.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---

<section id="schedule-quality" class="bg-white section-pad" aria-labelledby="quality-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <div class="lg:col-span-5">
        <p class="eyebrow scroll-reveal">{tr.showcase.eyebrow}</p>
        <h2 id="quality-heading" class="mt-4 text-section-sm sm:text-section font-bold tracking-tight scroll-reveal stagger-2">
          {tr.showcase.title}
        </h2>
        <p class="mt-4 text-[17px] leading-relaxed text-slate-gray scroll-reveal stagger-3">{tr.showcase.lead}</p>

        <ul class="mt-8 space-y-3.5">
          {
            tr.showcase.checks.map((c, i) => (
              <li class={`flex items-start gap-3 scroll-reveal stagger-${Math.min(i + 1, 6)}`}>
                <span class="mt-0.5 inline-flex items-center justify-center w-5 h-5 rounded-full bg-success-green/12 text-success-green shrink-0">
                  <svg class="w-3 h-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5l3.2 3.2L15.5 6" />
                  </svg>
                </span>
                <span class="text-[14.5px] leading-relaxed text-slate-gray">{c}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-7 scroll-reveal stagger-2">
        <HealthCheck heading={tr.showcase.healthTitle} note={tr.showcase.healthNote} />
      </div>
    </div>

    <!-- EVM block -->
    <div class="mt-20 lg:mt-28 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-7 order-2 lg:order-1 scroll-reveal">
        <SCurve legend={tr.showcase.evmLegend} title={tr.showcase.evmTitle} />
      </div>
      <div class="lg:col-span-5 order-1 lg:order-2">
        <h3 class="text-[26px] sm:text-[30px] font-bold tracking-tight leading-tight scroll-reveal">{tr.showcase.evmTitle}</h3>
        <p class="mt-4 text-[16px] leading-relaxed text-slate-gray scroll-reveal stagger-2">{tr.showcase.evmLead}</p>
        <a href="#contact" class="mt-7 inline-flex items-center gap-2 text-[15px] font-semibold text-deep-blue scroll-reveal stagger-3 hover:gap-3 transition-all">
          {tr.cta.primary}
          <svg class="w-4 h-4 rtl:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h11m0 0-4-4m4 4-4 4" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
