---
import { t, type Lang } from '../i18n/content';
import Dashboard from './visuals/Dashboard.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---

<section id="deliverables" class="bg-white section-pad" aria-labelledby="deliverables-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12 lg:mb-16">
      <p class="eyebrow scroll-reveal">{tr.deliverables.eyebrow}</p>
      <h2 id="deliverables-heading" class="mt-4 text-section-sm sm:text-section font-bold tracking-tight scroll-reveal stagger-2">
        {tr.deliverables.title}
      </h2>
      <p class="mt-4 text-[17px] leading-relaxed text-slate-gray scroll-reveal stagger-3">{tr.deliverables.lead}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      <ul class="lg:col-span-5 divide-y divide-line border-y border-line">
        {
          tr.deliverables.items.map((d, i) => (
            <li class={`py-5 flex items-start gap-4 scroll-reveal stagger-${Math.min(i + 1, 6)}`}>
              <span class="mt-0.5 font-mono text-[11px] font-semibold text-deep-blue/70 shrink-0 w-6">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0">
                <h3 class="text-[15.5px] font-semibold text-charcoal">{d.title}</h3>
                <p class="mt-1 text-[13.5px] leading-relaxed text-slate-gray">{d.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="lg:col-span-7 scroll-reveal stagger-2">
        <Dashboard />
      </div>
    </div>
  </div>
</section>
