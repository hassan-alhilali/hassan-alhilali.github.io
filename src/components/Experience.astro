---
import { t, type Lang } from '../i18n/content';
import siteData from '../data/site.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const ex = tr.experience;

const dutyIcons = [
  // monitoring — pulse over a timeline
  'M3 17h4l2.5-6 3 9 2.5-6H21',
  // review — document with magnifier
  'M6 3h8l4 4v6M6 3v18h6M14 3v4h4M17 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2.2-.8L21 22',
  // verify — shield check
  'M12 3l7.5 3v5.5c0 4.4-3 8.2-7.5 9.5-4.5-1.3-7.5-5.1-7.5-9.5V6zM9 12.2l2.2 2.2L15.5 10',
  // report — bars
  'M4 20V10M10 20V4M16 20v-7M22 20H2',
];
---

<section id="experience" class="bg-white section-pad" aria-labelledby="experience-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12 lg:mb-16">
      <p class="eyebrow scroll-reveal">{ex.eyebrow}</p>
      <h2 id="experience-heading" class="mt-4 text-section-sm sm:text-section font-bold tracking-tight scroll-reveal stagger-2">
        {ex.title}
      </h2>
      <p class="mt-4 text-[17px] leading-relaxed text-slate-gray scroll-reveal stagger-3">{ex.lead}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-6">
      <!-- role card -->
      <article class="lg:col-span-5 relative overflow-hidden rounded-2xl bg-navy text-white p-7 lg:p-8 scroll-reveal">
        <div
          class="absolute inset-0 pointer-events-none"
          aria-hidden="true"
          style="background: radial-gradient(520px 320px at 100% 0%, rgba(245,158,11,0.18), transparent 60%), radial-gradient(480px 300px at 0% 100%, rgba(37,99,235,0.28), transparent 60%);"
        >
        </div>
        <div class="relative">
          <p class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-success-green/15 text-[11.5px] font-semibold text-[#4ADE80]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#4ADE80]"></span>
            {ex.current}
          </p>

          <div class="mt-6 flex items-center gap-4">
            <span class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-white/[0.07] border border-white/10 text-amber shrink-0">
              <!-- generic oil derrick mark -->
              <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
                <path d="M16 3L9 29M16 3l7 26M11.2 21h9.6M12.8 14h6.4M14.3 8.5h3.4M6 29h20" />
              </svg>
            </span>
            <div>
              <h3 class="text-[20px] font-bold !text-white leading-tight">{siteData.employer.org[lang]}</h3>
              <p class="mt-1 text-[13px] text-white/45">{siteData.employer.parent[lang]}</p>
            </div>
          </div>

          <p class="mt-6 text-[15.5px] font-semibold text-sky">{siteData.employer.role[lang]}</p>

          <dl class="mt-7 grid gap-3">
            {
              ex.stats.map((s) => (
                <div class="flex items-start gap-3 rounded-xl bg-white/[0.04] border border-white/[0.08] px-4 py-3.5">
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-amber shrink-0" aria-hidden="true" />
                  <div>
                    <dt class="text-[14px] font-bold text-white">{s.k}</dt>
                    <dd class="mt-0.5 text-[13px] leading-relaxed text-white/55">{s.v}</dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>
      </article>

      <!-- duties -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5">
        {
          ex.duties.map((d, i) => (
            <article class={`card card-hover p-6 scroll-reveal stagger-${i + 2}`}>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-deep-blue/8 text-deep-blue">
                  <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={dutyIcons[i]} />
                  </svg>
                </span>
                <span class="font-mono text-[28px] font-bold text-charcoal/[0.08] leading-none" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <h3 class="mt-5 text-[17px] font-bold text-charcoal tracking-tight">{d.title}</h3>
              <p class="mt-2.5 text-[14px] leading-relaxed text-slate-gray">{d.desc}</p>
            </article>
          ))
        }
      </div>
    </div>

    <!-- review-cycle infographic -->
    <div class="mt-14 lg:mt-20 rounded-2xl border border-line bg-off-white p-6 sm:p-8 lg:p-10 scroll-reveal">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2">
        <h3 class="text-[20px] sm:text-[22px] font-bold tracking-tight">{ex.flowTitle}</h3>
        <p class="text-[12.5px] text-steel-blue">{ex.flowNote}</p>
      </div>

      <ol class="relative mt-9 grid grid-cols-1 md:grid-cols-5 gap-6 md:gap-4">
        <!-- connector (desktop horizontal, mobile vertical) -->
        <span class="hidden md:block absolute top-[27px] inset-x-[10%] h-[2px] bg-gradient-to-r rtl:bg-gradient-to-l from-deep-blue via-amber to-success-green opacity-60 line-reveal" aria-hidden="true"></span>
        <span class="md:hidden absolute top-2 bottom-2 start-[27px] w-[2px] bg-gradient-to-b from-deep-blue via-amber to-success-green opacity-50" aria-hidden="true"></span>
        {
          ex.flow.map((f, i) => {
            const last = i === ex.flow.length - 1;
            return (
              <li class={`relative flex md:flex-col items-start md:items-center gap-4 md:gap-0 md:text-center scroll-reveal stagger-${i + 1}`}>
                <span
                  class={`relative z-10 inline-flex items-center justify-center w-14 h-14 rounded-full border-4 border-off-white shadow-[0_8px_20px_-10px_rgba(15,23,42,0.5)] font-mono text-[15px] font-bold text-white shrink-0 ${
                    last ? 'bg-success-green' : i === 1 ? 'bg-amber' : 'bg-deep-blue'
                  }`}
                >
                  {last ? (
                    <svg class="w-6 h-6" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5l3.2 3.2L15.5 6" />
                    </svg>
                  ) : (
                    String(i + 1).padStart(2, '0')
                  )}
                </span>
                <div class="md:mt-4">
                  <p class="text-[15px] font-bold text-charcoal">{f.k}</p>
                  <p class="mt-1 text-[13px] leading-relaxed text-slate-gray md:px-1">{f.v}</p>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>

    <p class="mt-8 flex items-start gap-3 rounded-xl border border-line bg-white px-5 py-4 text-[13.5px] leading-relaxed text-slate-gray scroll-reveal">
      <svg class="w-5 h-5 mt-0.5 shrink-0 text-deep-blue" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 2.5l6 2.5v4.5c0 3.8-2.6 6.9-6 8-3.4-1.1-6-4.2-6-8V5l6-2.5z" />
      </svg>
      <span>{ex.independence}</span>
    </p>
  </div>
</section>
