---
import siteData from '../data/site.json';
---

<section id="about" class="bg-off-white py-16 lg:py-24" aria-labelledby="about-heading">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <article>
        <h2 id="about-heading" class="text-3xl sm:text-4xl font-bold text-charcoal mb-4">
          About Me
        </h2>
        <p class="text-base sm:text-lg text-slate-gray leading-relaxed">
          {siteData.summary}
        </p>
      </article>

      <div
        class="w-64 h-64 mx-auto md:mx-0 bg-gray-200 rounded-lg flex items-center justify-center"
        role="img"
        aria-label="Professional headshot placeholder"
      >
      </div>
    </div>
  </div>
</section>
