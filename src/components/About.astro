---
import { t, type Lang } from '../i18n/content';
import siteData from '../data/site.json';
import sectors from '../data/sectors.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---

<section id="about" class="relative bg-white section-pad overflow-hidden" aria-labelledby="about-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="eyebrow scroll-reveal">{tr.about.eyebrow}</p>
      <h2 id="about-heading" class="mt-4 text-section-sm sm:text-section font-bold tracking-tight scroll-reveal stagger-2">
        {tr.about.title}
      </h2>
      <p class="mt-3 text-[15px] font-medium text-deep-blue scroll-reveal stagger-2">
        {siteData.fullName[lang]} — {siteData.title[lang]}
      </p>
    </div>

    <div class="relative mt-8 sm:mt-10 overflow-hidden rounded-2xl border border-line bg-[#f1f4f8] shadow-[0_24px_55px_-38px_rgba(15,23,42,0.5)] scroll-reveal">
      <img
        src="/images/about.jpg"
        alt={tr.about.photoAlt}
        width="1800"
        height="648"
        class="block w-full h-auto"
        loading="lazy"
      />
    </div>

    <div class="mt-8 max-w-4xl">
      <p class="text-[16.5px] leading-[1.75] text-slate-gray scroll-reveal stagger-3">
        {siteData.summary[lang]}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-2 scroll-reveal stagger-4">
        {
          sectors.map((s) => (
            <span class="px-3 py-1.5 rounded-lg bg-off-white border border-line text-[13px] font-medium text-charcoal">
              {s.name[lang]}
            </span>
          ))
        }
      </div>

      <a
        href="#contact"
        class="mt-7 inline-flex items-center gap-2 text-[15px] font-semibold text-deep-blue hover:gap-3 transition-all scroll-reveal stagger-5"
      >
        {tr.cta.primary}
        <svg class="w-4 h-4 rtl:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h11m0 0-4-4m4 4-4 4" />
        </svg>
      </a>
    </div>
  </div>
</section>
