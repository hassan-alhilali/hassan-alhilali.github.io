---
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---

<section id="faq" class="bg-off-white section-pad" aria-labelledby="faq-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="eyebrow scroll-reveal">{tr.faq.eyebrow}</p>
        <h2 id="faq-heading" class="mt-4 text-section-sm sm:text-section font-bold tracking-tight scroll-reveal stagger-2">
          {tr.faq.title}
        </h2>
      </div>

      <div class="lg:col-span-8 divide-y divide-line border-y border-line">
        {
          tr.faq.items.map((f, i) => (
            <details class={`group py-5 scroll-reveal stagger-${Math.min(i + 1, 6)}`} name="faq" open={i === 0}>
              <summary class="flex items-center gap-4 cursor-pointer list-none text-[16px] font-semibold text-charcoal marker:hidden">
                <span class="flex-1">{f.q}</span>
                <span class="shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-full border border-line text-slate-gray transition-transform duration-300 group-open:rotate-45">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" d="M10 4v12M4 10h12" />
                  </svg>
                </span>
              </summary>
              <p class="mt-3 pe-11 text-[14.5px] leading-relaxed text-slate-gray">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
