---
/**
 * Illustrative Power BI style project controls dashboard.
 */
interface Props {
  title?: string;
  note?: string;
}
const { title = 'Project Controls Dashboard', note = 'Illustrative — refreshed from Primavera P6' } = Astro.props;

const kpis = [
  { label: 'Overall progress', value: '58.4%', delta: '+3.1 pts', tone: 'ok' },
  { label: 'SPI', value: '0.86', delta: '-0.04', tone: 'warn' },
  { label: 'CPI', value: '0.92', delta: '-0.01', tone: 'warn' },
  { label: 'Critical activities', value: '31', delta: '4 slipped', tone: 'bad' },
];

const disciplines = [
  { name: 'Civil', plan: 72, actual: 66 },
  { name: 'Structural', plan: 61, actual: 58 },
  { name: 'Mechanical', plan: 48, actual: 39 },
  { name: 'Piping', plan: 40, actual: 31 },
  { name: 'E & I', plan: 27, actual: 24 },
];

const manpower = [42, 56, 71, 88, 104, 122, 131, 118, 96, 74, 58, 40];
const maxMan = Math.max(...manpower);

// donut: progress by area
const areas = [
  { name: 'Area 100', v: 34, c: '#2563EB' },
  { name: 'Area 200', v: 26, c: '#3B82F6' },
  { name: 'Area 300', v: 22, c: '#93C5FD' },
  { name: 'Utilities', v: 18, c: '#CBD5E1' },
];
let acc = 0;
const R = 30;
const C = 2 * Math.PI * R;
const arcs = areas.map((a) => {
  const seg = { ...a, dash: (a.v / 100) * C, offset: -(acc / 100) * C };
  acc += a.v;
  return seg;
});
---

<figure
  class="rounded-2xl border border-line bg-white overflow-hidden shadow-[0_30px_70px_-45px_rgba(15,23,42,0.5)]"
  dir="ltr"
  role="img"
  aria-label={`${title} — ${note}`}
>
  <div class="flex items-center gap-2 px-4 h-11 border-b border-line bg-off-white">
    <span class="w-2.5 h-2.5 rounded-full bg-critical/60"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-amber/60"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-success-green/60"></span>
    <span class="ms-3 text-[11px] font-semibold text-charcoal truncate">{title}</span>
    <span class="ms-auto text-[10px] font-mono text-warm-gray hidden sm:inline">{note}</span>
  </div>

  <div class="p-4 sm:p-5 space-y-4">
    <!-- KPI row -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
      {
        kpis.map((k) => (
          <div class="rounded-xl border border-line bg-off-white/60 px-3.5 py-3">
            <p class="text-[10.5px] uppercase tracking-[0.12em] text-steel-blue font-semibold">{k.label}</p>
            <p class="text-[22px] leading-tight font-bold text-charcoal mt-1 font-mono">{k.value}</p>
            <p
              class="text-[11px] mt-0.5 font-medium"
              style={`color:${k.tone === 'ok' ? '#15803D' : k.tone === 'warn' ? '#B45309' : '#B91C1C'}`}
            >
              {k.delta}
            </p>
          </div>
        ))
      }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-4">
      <!-- discipline progress -->
      <div class="lg:col-span-3 rounded-xl border border-line p-4">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-steel-blue mb-3">Progress by discipline</p>
        <ul class="space-y-2.5">
          {
            disciplines.map((d) => (
              <li class="flex items-center gap-3 text-[12px]">
                <span class="w-[74px] shrink-0 text-slate-gray">{d.name}</span>
                <span class="relative flex-1 h-[14px] rounded bg-off-white overflow-hidden">
                  <span class="absolute inset-y-0 left-0 bg-line rounded" style={`width:${d.plan}%`} />
                  <span
                    class="absolute inset-y-[3px] left-0 rounded"
                    style={`width:${d.actual}%;background:${d.actual < d.plan - 5 ? '#DC2626' : '#2563EB'}`}
                  />
                </span>
                <span class="w-[64px] shrink-0 text-end font-mono text-[11px] text-charcoal">
                  {d.actual}% / {d.plan}%
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-[10.5px] text-warm-gray">Bar = actual · Track = planned</p>
      </div>

      <!-- donut -->
      <div class="lg:col-span-2 rounded-xl border border-line p-4">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-steel-blue mb-3">Scope weight by area</p>
        <div class="flex items-center gap-4">
          <svg viewBox="0 0 80 80" class="w-[80px] h-[80px] shrink-0 -rotate-90" aria-hidden="true">
            {
              arcs.map((a) => (
                <circle
                  cx="40"
                  cy="40"
                  r={R}
                  fill="none"
                  stroke={a.c}
                  stroke-width="13"
                  stroke-dasharray={`${a.dash} ${C}`}
                  stroke-dashoffset={a.offset}
                />
              ))
            }
          </svg>
          <ul class="space-y-1.5 text-[11.5px] min-w-0">
            {
              areas.map((a) => (
                <li class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-sm shrink-0" style={`background:${a.c}`} />
                  <span class="text-slate-gray truncate">{a.name}</span>
                  <span class="ms-auto font-mono text-charcoal">{a.v}%</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- manpower histogram -->
    <div class="rounded-xl border border-line p-4">
      <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-steel-blue mb-3">Manpower histogram (planned)</p>
      <div class="flex items-end gap-[6px] h-[74px]">
        {
          manpower.map((m, i) => (
            <span
              class="flex-1 rounded-t-sm"
              style={`height:${(m / maxMan) * 100}%;background:${i === 6 ? '#F59E0B' : '#93C5FD'}`}
              title={`M${i + 1}: ${m}`}
            />
          ))
        }
      </div>
      <div class="flex gap-[6px] mt-1.5">
        {manpower.map((_, i) => <span class="flex-1 text-center text-[9px] font-mono text-warm-gray">M{i + 1}</span>)}
      </div>
    </div>
  </div>
</figure>
