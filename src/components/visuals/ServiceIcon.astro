---
interface Props {
  name: string;
  class?: string;
}
const { name, class: cls = 'w-6 h-6' } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'gantt' && (
      <g>
        <rect x="3" y="4" width="9" height="3" rx="1.2" />
        <rect x="7" y="10.5" width="11" height="3" rx="1.2" />
        <rect x="12" y="17" width="8" height="3" rx="1.2" />
        <path d="M3 4v16" opacity="0.4" />
      </g>
    )
  }
  {
    name === 'check' && (
      <g>
        <path d="M12 3l7.5 3v5.5c0 4.4-3 8.2-7.5 9.5-4.5-1.3-7.5-5.1-7.5-9.5V6z" />
        <path d="M9 12.2l2.2 2.2L15.5 10" />
      </g>
    )
  }
  {
    name === 'recovery' && (
      <g>
        <path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1" />
        <path d="M3 4v4.5h4.5" />
        <path d="M12 8v4.4l3 1.8" />
      </g>
    )
  }
  {
    name === 'curve' && (
      <g>
        <path d="M3 20V4" opacity="0.4" />
        <path d="M3 20h18" opacity="0.4" />
        <path d="M4.5 17.5c3.5 0 4.5-9 8-9s4.5 5 7 5" />
        <path d="M4.5 19.8c3.5 0 5-6.5 8.5-6.5" stroke-dasharray="2.5 2.5" opacity="0.7" />
      </g>
    )
  }
  {
    name === 'dashboard' && (
      <g>
        <rect x="3" y="4" width="18" height="16" rx="2.2" />
        <path d="M3 9h18" opacity="0.5" />
        <path d="M7.5 16v-3.5M12 16v-5.5M16.5 16v-2" />
      </g>
    )
  }
  {
    name === 'structure' && (
      <g>
        <rect x="9" y="3" width="6" height="4" rx="1.2" />
        <rect x="3" y="16" width="6" height="4" rx="1.2" />
        <rect x="15" y="16" width="6" height="4" rx="1.2" />
        <path d="M12 7v4.5M6 16v-4.5h12V16" />
      </g>
    )
  }
</svg>
