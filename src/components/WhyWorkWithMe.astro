---
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---

<section id="why" class="relative bg-navy text-white section-pad overflow-hidden" aria-labelledby="why-heading">
  <div
    class="absolute inset-0"
    aria-hidden="true"
    style="background: radial-gradient(720px 420px at 82% 8%, rgba(37,99,235,0.22), transparent 62%);"
  >
  </div>

  <div class="relative max-w-content mx-auto px-5 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12 lg:mb-16">
      <p class="eyebrow scroll-reveal !text-sky">{tr.why.eyebrow}</p>
      <h2 id="why-heading" class="mt-4 text-section-sm sm:text-section font-bold tracking-tight !text-white scroll-reveal stagger-2">
        {tr.why.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 lg:gap-y-14">
      {
        tr.why.items.map((item, i) => (
          <article class={`scroll-reveal stagger-${Math.min(i + 1, 6)}`}>
            <div class="flex items-center gap-3">
              <span class="font-mono text-[12px] font-bold text-sky/80">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex-1 h-px bg-white/10" />
            </div>
            <h3 class="mt-4 text-[21px] font-bold tracking-tight !text-white">{item.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-white/52 max-w-prose">{item.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
