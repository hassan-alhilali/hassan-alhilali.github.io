---
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---

<section class="relative bg-navy border-t border-white/[0.07]" aria-label={tr.metrics[0].k}>
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-8">
    <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 divide-white/[0.07] sm:gap-px">
      {
        tr.metrics.map((m, i) => (
          <div class={`py-8 lg:py-10 sm:px-6 lg:px-7 ${i > 0 ? 'sm:border-s sm:border-white/[0.07]' : ''} ${i === 0 ? 'lg:ps-0' : ''}`}>
            <dt class="text-[15px] font-bold text-white tracking-tight">{m.k}</dt>
            <dd class="mt-2 text-[13.5px] leading-relaxed text-white/45">{m.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
