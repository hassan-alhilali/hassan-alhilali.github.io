---
import { t, localePath, type Lang } from '../i18n/content';
import siteData from '../data/site.json';
import LogoMark from './visuals/LogoMark.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const other: Lang = lang === 'en' ? 'ar' : 'en';
const year = new Date().getFullYear();

const links = [
  { label: tr.nav.services, href: '#services' },
  { label: tr.nav.approach, href: '#approach' },
  { label: tr.nav.deliverables, href: '#deliverables' },
  { label: tr.nav.expertise, href: '#expertise' },
  { label: tr.nav.about, href: '#about' },
  { label: tr.nav.contact, href: '#contact' },
];
---

<footer class="bg-ink text-white/60 border-t border-white/[0.07]">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-8 py-12 lg:py-14">
    <div class="flex flex-col lg:flex-row lg:items-start gap-10 lg:gap-16">
      <div class="lg:max-w-xs">
        <div class="flex items-center gap-2.5">
          <LogoMark tone="light" class="w-8 h-8" />
          <span class="text-[15px] font-bold text-white tracking-tight">{siteData.compactName[lang]}</span>
        </div>
        <p class="mt-4 text-[13.5px] leading-relaxed text-white/45">{tr.footer.tagline}</p>
      </div>

      <nav class="lg:ms-auto" aria-label={tr.nav.home}>
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-10 gap-y-2.5">
          {
            links.map((l) => (
              <li>
                <a href={l.href} class="text-[13.5px] text-white/55 hover:text-white">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-3">
        <a href={`mailto:${siteData.email}`} class="text-[13.5px] text-sky hover:text-white break-all">{siteData.email}</a>
        <a
          href={localePath(other)}
          hreflang={other}
          class="inline-flex items-center gap-1.5 w-fit px-3 h-8 rounded-full border border-white/20 text-[12.5px] font-semibold text-white/80 hover:bg-white/10"
        >
          {tr.meta.switchLabel}
        </a>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-white/[0.07] flex flex-col sm:flex-row items-start sm:items-center gap-3">
      <p class="text-[12.5px] text-white/35">© {year} {siteData.fullName[lang]}. {tr.footer.rights}</p>
      <a href="#hero" class="sm:ms-auto text-[12.5px] text-white/45 hover:text-white inline-flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 16V4m0 0L5.5 8.5M10 4l4.5 4.5" />
        </svg>
        {tr.footer.backToTop}
      </a>
    </div>
  </div>
</footer>
