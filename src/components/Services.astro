---
import type { Service } from '../types/index';
import servicesData from '../data/services.json';

const services: Service[] = servicesData;
---

<section id="services" class="bg-off-white py-16 lg:py-24" aria-labelledby="services-heading">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 id="services-heading" class="text-3xl sm:text-4xl font-bold text-charcoal mb-4">
        Services
      </h2>
      <p class="text-lg text-slate-gray max-w-2xl mx-auto">
        Specialized project controls solutions tailored to your needs.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service) => (
        <article class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <h3 class="text-xl font-semibold text-charcoal mb-3">
            {service.title}
          </h3>
          <p class="text-slate-gray leading-relaxed">
            {service.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
