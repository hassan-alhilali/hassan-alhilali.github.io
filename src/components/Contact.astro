---
import siteData from '../data/site.json';
---

<section id="contact" class="bg-off-white py-16 lg:py-24" aria-labelledby="contact-heading">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 id="contact-heading" class="text-3xl sm:text-4xl font-bold text-charcoal mb-4">
      Get In Touch
    </h2>

    <div class="max-w-2xl mx-auto space-y-6">
      <a
        href={`mailto:${siteData.email}`}
        class="inline-block bg-charcoal text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-slate-gray transition-colors duration-200"
      >
        Discuss a Project
      </a>

      <p class="text-slate-gray">
        <span class="block">{siteData.location}</span>
        <span class="block mt-1">{siteData.availability}</span>
      </p>
    </div>
  </div>
</section>
