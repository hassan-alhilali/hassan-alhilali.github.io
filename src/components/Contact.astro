---
import { t, type Lang } from '../i18n/content';
import siteData from '../data/site.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);

const subject = encodeURIComponent(lang === 'ar' ? 'استفسار عن خدمات بريمافيرا P6' : 'Primavera P6 / project controls enquiry');
const mailto = `mailto:${siteData.email}?subject=${subject}`;
---

<section id="contact" class="relative bg-navy text-white section-pad overflow-hidden" aria-labelledby="contact-heading">
  <div class="absolute inset-0" aria-hidden="true">
    <img src="/images/contact-bg.jpg" alt="" class="w-full h-full object-cover opacity-[0.07]" loading="lazy" />
  </div>
  <div
    class="absolute inset-0"
    aria-hidden="true"
    style="background: radial-gradient(760px 460px at 20% 10%, rgba(37,99,235,0.26), transparent 62%), linear-gradient(180deg, rgba(11,18,32,0.86), #070B14);"
  >
  </div>

  <div class="relative max-w-content mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-7">
        <p class="eyebrow scroll-reveal !text-sky">{tr.contact.eyebrow}</p>
        <h2 id="contact-heading" class="mt-4 text-section-sm sm:text-section font-bold tracking-tight !text-white scroll-reveal stagger-2">
          {tr.contact.title}
        </h2>
        <p class="mt-5 text-[17px] leading-relaxed text-white/55 max-w-prose scroll-reveal stagger-3">{tr.contact.lead}</p>

        <div class="mt-9 flex flex-wrap items-center gap-3 scroll-reveal stagger-4">
          <a href={mailto} class="btn-primary shadow-[0_16px_36px_-16px_rgba(37,99,235,0.9)]">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <rect x="2.5" y="4" width="15" height="12" rx="2" />
              <path d="M3 5.5l7 5 7-5" stroke-linecap="round" />
            </svg>
            {siteData.email}
          </a>
          {
            siteData.linkedin && (
              <a href={siteData.linkedin} target="_blank" rel="noopener noreferrer" class="btn-ghost-dark">
                {tr.contact.linkedinLabel}
              </a>
            )
          }
        </div>
      </div>

      <div class="lg:col-span-5 scroll-reveal stagger-3">
        <dl class="rounded-2xl border border-white/10 bg-white/[0.04] backdrop-blur-sm divide-y divide-white/10">
          <div class="px-6 py-5">
            <dt class="text-[11px] font-semibold uppercase tracking-[0.15em] text-white/40">{tr.contact.emailLabel}</dt>
            <dd class="mt-1.5">
              <a href={mailto} class="text-[15px] font-medium text-sky hover:text-white break-all">{siteData.email}</a>
            </dd>
          </div>
          <div class="px-6 py-5">
            <dt class="text-[11px] font-semibold uppercase tracking-[0.15em] text-white/40">{tr.contact.locationLabel}</dt>
            <dd class="mt-1.5 text-[15px] text-white/75">{siteData.location[lang]}</dd>
          </div>
          <div class="px-6 py-5">
            <dt class="text-[11px] font-semibold uppercase tracking-[0.15em] text-white/40">{tr.contact.availabilityLabel}</dt>
            <dd class="mt-1.5 flex items-center gap-2 text-[15px] text-white/75">
              <span class="w-2 h-2 rounded-full bg-success-green shadow-[0_0_10px_rgba(22,163,74,0.9)]"></span>
              {siteData.availability[lang]}
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
