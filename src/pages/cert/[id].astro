---
// Landing page for a certificate's QR code: /cert/<id>/
import CertLayout from '../../layouts/CertLayout.astro';
import siteData from '../../data/site.json';
import { certs, absolute, qrSvg } from '../../lib/certs';

export function getStaticPaths() {
  return certs.map((c) => ({ params: { id: c.id }, props: { cert: c } }));
}

const { cert: c } = Astro.props;
const pageUrl = absolute(c.page, Astro.site);
const fileUrl = c.src ? absolute(c.src, Astro.site) : '';
const qr = await qrSvg(pageUrl);
const qrDownload = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(qr)}`;
---

<CertLayout
  title={`${c.title.ar} | ${siteData.compactName.ar}`}
  description={`${c.title.ar} — ${siteData.fullName.ar}`}
  image={c.kind === 'image' ? fileUrl : undefined}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- certificate -->
    <div class="lg:col-span-8">
      <div class="card overflow-hidden">
        {c.kind === 'image' && (
          <a href={c.src} target="_blank" rel="noopener">
            <img src={c.src} alt={c.title.ar} class="block w-full h-auto bg-white" />
          </a>
        )}
        {c.kind === 'pdf' && <iframe src={c.src} title={c.title.ar} class="block w-full h-[80vh] bg-white" />}
        {c.kind === 'none' && (
          <div class="aspect-[4/3] flex flex-col items-center justify-center gap-3 bg-white text-center p-8">
            <span class="inline-flex w-16 h-16 items-center justify-center rounded-full bg-amber/15 text-amber text-3xl">★</span>
            <p class="text-[15px] font-semibold text-charcoal">لم تُرفع صورة هذه الشهادة بعد</p>
            <p class="text-[13px] text-steel-blue">Certificate image not uploaded yet</p>
          </div>
        )}
      </div>
      {c.src && (
        <a href={c.src} download class="no-print mt-4 inline-flex btn-outline">
          تنزيل الشهادة · Download
        </a>
      )}
    </div>

    <!-- details -->
    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6">
        <p class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-success-green/10 text-[12px] font-semibold text-success-green">
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5l3.2 3.2L15.5 6" />
          </svg>
          حامل الشهادة
        </p>
        <p class="mt-3 text-[18px] font-bold text-charcoal">{siteData.fullName.ar}</p>
        <p class="text-[13.5px] text-steel-blue" dir="ltr">{siteData.fullName.en}</p>

        <dl class="mt-5 pt-5 border-t border-line grid gap-4 text-[14px]">
          <div>
            <dt class="text-[12px] text-steel-blue">الشهادة · Certificate</dt>
            <dd class="mt-0.5 font-semibold text-charcoal">{c.title.ar}</dd>
            <dd class="text-[13px] text-slate-gray" dir="ltr">{c.title.en}</dd>
          </div>
          <div>
            <dt class="text-[12px] text-steel-blue">الجهة المانحة · Issuer</dt>
            <dd class="mt-0.5 font-semibold text-charcoal">{c.issuer.ar || '—'}</dd>
            {c.issuer.en && c.issuer.en !== c.issuer.ar && <dd class="text-[13px] text-slate-gray" dir="ltr">{c.issuer.en}</dd>}
          </div>
          {c.year && (
            <div>
              <dt class="text-[12px] text-steel-blue">السنة · Year</dt>
              <dd class="mt-0.5 font-semibold text-charcoal">{c.year}</dd>
            </div>
          )}
          {c.hours && (
            <div>
              <dt class="text-[12px] text-steel-blue">الساعات التدريبية · Hours</dt>
              <dd class="mt-0.5 font-semibold text-charcoal">{c.hours}</dd>
            </div>
          )}
        </dl>
      </div>

      {c.verifyId && (
        <div class="card p-6">
          <p class="text-[12px] text-steel-blue">رقم التحقق لدى الجهة المانحة · Issuer verification ID</p>
          <p class="mt-1 font-mono text-[16px] font-semibold text-charcoal" dir="ltr">{c.verifyId}</p>
          {c.verifyUrl && (
            <a href={c.verifyUrl} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex btn-outline">
              التحقق لدى {c.issuer.ar} ↗
            </a>
          )}
          <p class="mt-3 text-[12px] leading-relaxed text-steel-blue">
            التحقق الرسمي من صحة هذه الشهادة يتم عبر الجهة المانحة باستخدام الرقم أعلاه.
          </p>
        </div>
      )}

      <div class="card p-6 text-center">
        <div class="mx-auto w-44 h-44" set:html={qr} />
        <p class="mt-3 text-[12.5px] font-semibold text-success-green">امسح الرمز لعرض الشهادة</p>
        <a href={qrDownload} download={`qr-${c.id}.svg`} class="no-print mt-4 inline-flex btn-outline">تنزيل رمز QR</a>
      </div>
    </aside>
  </div>
</CertLayout>
