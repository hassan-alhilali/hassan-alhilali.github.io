---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Metrics from '../components/Metrics.astro';
import Services from '../components/Services.astro';
import ScheduleQuality from '../components/ScheduleQuality.astro';
import Approach from '../components/Approach.astro';
import Deliverables from '../components/Deliverables.astro';
import WhyWorkWithMe from '../components/WhyWorkWithMe.astro';
import Expertise from '../components/Expertise.astro';
import About from '../components/About.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const lang = 'en' as const;
---

<Layout lang={lang}>
  <Header lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />
    <Metrics lang={lang} />
    <Services lang={lang} />
    <ScheduleQuality lang={lang} />
    <Approach lang={lang} />
    <Deliverables lang={lang} />
    <WhyWorkWithMe lang={lang} />
    <Expertise lang={lang} />
    <About lang={lang} />
    <FAQ lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
